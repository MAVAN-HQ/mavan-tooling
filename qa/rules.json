{
  "version": "0.1",
  "note": "Baseline-free rules. Tier fault may fail a build; tier smell is report only. Every rule must ship a fixture that makes it fail (prove the gate can fail). Each finding records the viewport (width AND height) it fired at. Source: Marylebone session, 2026-11-04.",
  "firstSlice": [
    "geo.viewport-overflow",
    "geo.clipped-text",
    "geo.micro-scroller",
    "media.duplicate-sibling-src",
    "run.console-errors",
    "run.failed-requests"
  ],
  "needsRegistry": [
    "geo.text-overlap",
    "media.duplicate-sibling-src"
  ],
  "rules": [
    {
      "id": "geo.viewport-overflow",
      "n": "A1",
      "tier": "fault",
      "baseline": "none",
      "measure": "rect.right > innerWidth + 2, excluding elements inside an ancestor with overflow-x auto/scroll",
      "fixture": "120vw block",
      "severity": "high",
      "confidence": "certain",
      "default": true,
      "implemented": true
    },
    {
      "id": "geo.parent-overflow",
      "n": "A2",
      "tier": "fault",
      "baseline": "none",
      "measure": "child escapes padding box of an overflow:visible ancestor by >2px, neither absolute/fixed",
      "fixture": "long unbreakable string in fixed-width box",
      "severity": "medium",
      "confidence": "probable",
      "default": true,
      "implemented": true
    },
    {
      "id": "geo.clipped-text",
      "n": "A3",
      "tier": "fault",
      "baseline": "none",
      "measure": "scrollWidth > clientWidth + 2 with overflow hidden, no text-overflow ellipsis, no line-clamp",
      "fixture": "40-char word in 100px box",
      "severity": "high",
      "confidence": "probable",
      "default": true,
      "implemented": true
    },
    {
      "id": "geo.micro-scroller",
      "n": "A4",
      "tier": "fault",
      "baseline": "none",
      "measure": "scroll container overflowing by 1-100px on either axis; defer to scroll-containers.cjs if it already covers both axes",
      "fixture": "51px-overflow table",
      "severity": "medium",
      "confidence": "probable",
      "default": true,
      "implemented": true
    },
    {
      "id": "geo.zero-box",
      "n": "A5",
      "tier": "fault",
      "baseline": "none",
      "measure": "element with text or img child rounds to 0 width/height; not aria-hidden, not display:none, not sr-only",
      "fixture": "flex child min-width 0, no content width",
      "severity": "medium",
      "confidence": "probable",
      "default": true,
      "implemented": true
    },
    {
      "id": "geo.text-overlap",
      "n": "A6",
      "tier": "fault",
      "baseline": "none",
      "measure": "two text-bearing non-positioned elements intersecting >25% of the smaller area; needs registry whitelist; ship disabled until registry exists",
      "fixture": "negative margin pulls one block onto another",
      "severity": "medium",
      "confidence": "probable",
      "default": false,
      "implemented": true
    },
    {
      "id": "media.duplicate-sibling-src",
      "n": "A7",
      "tier": "fault",
      "baseline": "none",
      "measure": "2+ img/source in one component subtree resolve to the same basename; scope to nearest block-class ancestor; ship disabled until registry exists",
      "fixture": "two hero slots with the same photo",
      "severity": "high",
      "confidence": "probable",
      "default": false,
      "implemented": true
    },
    {
      "id": "media.image-distortion",
      "n": "A8",
      "tier": "fault",
      "baseline": "none",
      "measure": "rendered aspect differs from natural by >2% with object-fit none/fill",
      "fixture": "square source in 2:1 box, object-fit:fill",
      "severity": "medium",
      "confidence": "certain",
      "default": true,
      "implemented": true
    },
    {
      "id": "media.image-upscaled",
      "n": "A9",
      "tier": "fault",
      "baseline": "none",
      "measure": "rendered CSS width > naturalWidth / dpr by >15%",
      "fixture": "400px source rendered at 1000px",
      "severity": "low",
      "confidence": "certain",
      "default": true,
      "implemented": true
    },
    {
      "id": "media.percentage-clamp",
      "n": "A10",
      "tier": "fault",
      "baseline": "none",
      "measure": "img with inline/attr width >100% whose rendered width equals its container (clamped by img{max-width:100%}); use getBoundingClientRect",
      "fixture": "crop image at width:140%",
      "severity": "medium",
      "confidence": "probable",
      "default": true,
      "implemented": true
    },
    {
      "id": "run.console-errors",
      "n": "A11",
      "tier": "fault",
      "baseline": "none",
      "measure": "any console error or pageerror during load plus scroll sweep",
      "fixture": "page that throws",
      "severity": "high",
      "confidence": "certain",
      "default": true,
      "implemented": true
    },
    {
      "id": "run.failed-requests",
      "n": "A12",
      "tier": "fault",
      "baseline": "none",
      "measure": "any non-2xx/3xx response plus any CSP violation event",
      "fixture": "CSP that blocks a font host",
      "severity": "high",
      "confidence": "certain",
      "default": true,
      "implemented": true
    },
    {
      "id": "seo.heading-order",
      "n": "A13",
      "tier": "fault",
      "baseline": "none",
      "measure": "level skips, zero h1, or more than one h1 (already in site-checks; listed for completeness)",
      "fixture": "h1 then h3",
      "severity": "medium",
      "confidence": "certain",
      "default": true,
      "implemented": true
    },
    {
      "id": "a11y.tap-target",
      "n": "A14",
      "tier": "fault",
      "baseline": "none",
      "measure": "interactive rect under 24x24 CSS px at mobile width, excluding inline prose links",
      "fixture": "16px icon button",
      "severity": "low",
      "confidence": "probable",
      "default": true,
      "implemented": true
    },
    {
      "id": "typo.heading-line-count",
      "n": "B1",
      "tier": "smell",
      "baseline": "none",
      "measure": "heading wraps to more than 3 lines in its own column; tune per template",
      "fixture": "56-char H1 at display scale",
      "severity": "low",
      "confidence": "possible",
      "default": true,
      "implemented": true
    },
    {
      "id": "geo.extreme-aspect-text",
      "n": "B2",
      "tier": "smell",
      "baseline": "none",
      "measure": "text box >3x taller than wide with fewer than ~8 words",
      "fixture": "123x402 strip",
      "severity": "low",
      "confidence": "possible",
      "default": true,
      "implemented": true
    },
    {
      "id": "typo.measure",
      "n": "B3",
      "tier": "smell",
      "baseline": "none",
      "measure": "paragraph over ~90 characters per line",
      "fixture": "full-width paragraph at 1920",
      "severity": "low",
      "confidence": "possible",
      "default": true,
      "implemented": true
    },
    {
      "id": "a11y.contrast",
      "n": "B4",
      "tier": "smell",
      "baseline": "none",
      "measure": "below 4.5:1 body, 3:1 large",
      "fixture": "grey on white",
      "severity": "low",
      "confidence": "possible",
      "default": false,
      "implemented": false,
      "note": "Covered by site-checks (axe) / check-h2-contrast-sweep; adapter pending"
    },
    {
      "id": "geo.orphan-width",
      "n": "B5",
      "tier": "smell",
      "baseline": "none",
      "measure": "grid/flex track count leaves exactly one item alone on the last row",
      "fixture": "4 columns holding 5 cards",
      "severity": "low",
      "confidence": "possible",
      "default": true,
      "implemented": true
    }
  ]
}
